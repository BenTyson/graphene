enum ContactType {
  CLIENT
  INVESTOR // displayed as "Potential Investor"
  EXISTING_INVESTOR
  PARTNER
  OTHER
}

enum ContactKind {
  PERSON
  COMPANY
}

model Contact {
  id           String        @id @default(cuid())
  name         String
  contactKind  ContactKind   @default(PERSON) @map("contact_kind")
  email        String?
  phone        String?
  role         String?
  contactType  ContactType?  @map("contact_type") // legacy: pipeline board membership (single)
  contactTypes ContactType[] @default([]) @map("contact_types") // multi-categorization labels
  source       String?
  tags         String[]      @default([])
  notes        String?       @db.Text
  linkedInUrl  String?       @map("linkedin_url")
  website      String?

  // Self-referential: a Person can belong to a Company
  companyId      String?   @map("company_id")
  companyContact Contact?  @relation("CompanyPeople", fields: [companyId], references: [id])
  people         Contact[] @relation("CompanyPeople")

  ownerId String? @map("owner_id")
  owner   User?   @relation("ContactOwner", fields: [ownerId], references: [id])

  // Pipeline fields (null stage = not on any pipeline board)
  pipelineTitle String?   @map("pipeline_title")
  stage         String?
  position      Int       @default(0)
  closedAt      DateTime? @map("closed_at")
  lostReason    String?   @map("lost_reason")

  lastContactedAt DateTime? @map("last_contacted_at")
  nextFollowUpAt  DateTime? @map("next_follow_up_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  deals       Deal[]
  activities  ContactActivity[]
  attachments ContactAttachment[]

  @@index([contactKind])
  @@index([contactType])
  @@index([companyId])
  @@index([ownerId])
  @@index([stage])
  @@index([stage, position])
  @@index([nextFollowUpAt])
  @@index([lastContactedAt])
  @@index([createdAt])
  @@map("contacts")
}

model Deal {
  id          String   @id @default(cuid())
  title       String
  contactId   String   @map("contact_id")
  contact     Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stage       String
  position    Int      @default(0)
  description String?  @db.Text
  lostReason  String?  @map("lost_reason")
  tags        String[] @default([])

  ownerId String? @map("owner_id")
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id])

  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  activities DealActivity[]

  @@index([contactId])
  @@index([stage])
  @@index([ownerId])
  @@index([stage, position])
  @@index([createdAt])
  @@map("deals")
}

model ContactActivity {
  id        String  @id @default(cuid())
  contactId String  @map("contact_id")
  userId    String  @map("user_id")
  action    String
  content   String? @db.Text
  fromValue String? @map("from_value")
  toValue   String? @map("to_value")
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  user      User    @relation("ContactActivityUser", fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contactId, createdAt])
  @@map("contact_activities")
}

model DealActivity {
  id        String  @id @default(cuid())
  dealId    String  @map("deal_id")
  userId    String  @map("user_id")
  action    String
  content   String? @db.Text
  fromValue String? @map("from_value")
  toValue   String? @map("to_value")
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user      User    @relation("DealActivityUser", fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([dealId, createdAt])
  @@map("deal_activities")
}

model ContactAttachment {
  id           String   @id @default(cuid())
  contactId    String   @map("contact_id")
  uploadedById String   @map("uploaded_by_id")
  fileName     String   @map("file_name")
  filePath     String   @map("file_path")
  fileSize     Int      @map("file_size")
  mimeType     String?  @map("mime_type")
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation("ContactAttachmentUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([contactId, createdAt])
  @@map("contact_attachments")
}

// Per-user email notification preferences. 1:1 with User; lazy-created on first read.
model UserEmailPreferences {
  userId            String    @id @map("user_id")
  user              User      @relation("UserEmailPrefs", fields: [userId], references: [id], onDelete: Cascade)
  weeklyDigest      Boolean   @default(true) @map("weekly_digest")
  dueTomorrow       Boolean   @default(true) @map("due_tomorrow")
  overdue3Day       Boolean   @default(true) @map("overdue_3_day")
  overdue6Day       Boolean   @default(true) @map("overdue_6_day")
  overdue9Day       Boolean   @default(true) @map("overdue_9_day")
  onlyMyTasks       Boolean   @default(true) @map("only_my_tasks")
  includeUnassigned Boolean   @default(false) @map("include_unassigned")
  timezone          String    @default("America/Los_Angeles")
  unsubscribedAt    DateTime? @map("unsubscribed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("user_email_preferences")
}

// Singleton row (id = "default") storing global email settings, edited by superadmin only.
model EmailSettings {
  id                    String    @id @default("default")
  weeklyDigestEnabled   Boolean   @default(true) @map("weekly_digest_enabled")
  dueTomorrowEnabled    Boolean   @default(true) @map("due_tomorrow_enabled")
  overdueAlertsEnabled  Boolean   @default(true) @map("overdue_alerts_enabled")
  fromAddress           String    @default("HGraphene <no-reply@hgraphene.com>") @map("from_address")
  replyTo               String?   @map("reply_to")
  testRecipient         String?   @map("test_recipient")
  templateIdWeekly      Int?      @map("template_id_weekly")
  templateIdDueTomorrow Int?      @map("template_id_due_tomorrow")
  templateIdOverdue     Int?      @map("template_id_overdue")
  lastWeeklyRunAt       DateTime? @map("last_weekly_run_at")
  lastDueTomorrowRunAt  DateTime? @map("last_due_tomorrow_run_at")
  lastOverdueRunAt      DateTime? @map("last_overdue_run_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("email_settings")
}

enum EmailType {
  WEEKLY_DIGEST
  DUE_TOMORROW
  OVERDUE_3
  OVERDUE_6
  OVERDUE_9
  TEST
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

// Audit log + idempotency guard for outbound emails.
model EmailLog {
  id             String      @id @default(cuid())
  userId         String?     @map("user_id")
  user           User?       @relation("UserEmailLog", fields: [userId], references: [id], onDelete: SetNull)
  recipient      String
  type           EmailType
  status         EmailStatus
  idempotencyKey String      @unique @map("idempotency_key")
  taskIds        String[]    @default([]) @map("task_ids")
  templateId     Int?        @map("template_id")
  errorMessage   String?     @map("error_message")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("email_logs")
}
