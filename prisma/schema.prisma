enum UserRole {
  SUPER_ADMIN
  SCIENCE_TEAM
  EXECUTIVE_TEAM
  INVESTOR
  TEAM_MEMBER
  THIRD_PARTY
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole  @default(TEAM_MEMBER)
  firstName    String?   @map("first_name")
  lastName     String?   @map("last_name")
  isActive     Boolean   @default(true) @map("is_active")
  lastLogin    DateTime? @map("last_login")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  createdTasks    Task[]           @relation("TaskCreator")
  taskAssignments TaskAssignment[] @relation("TaskAssignmentUser")
  taskComments    TaskComment[]    @relation("TaskCommentAuthor")
  taskActivities  TaskActivity[]   @relation("TaskActivityUser")
  taskAttachments TaskAttachment[] @relation("TaskAttachmentUploader")

  ownedGoals   Goal[] @relation("GoalOwner")
  createdGoals Goal[] @relation("GoalCreator")

  ownedContacts      Contact[]           @relation("ContactOwner")
  ownedDeals         Deal[]              @relation("DealOwner")
  contactActivities  ContactActivity[]   @relation("ContactActivityUser")
  dealActivities     DealActivity[]      @relation("DealActivityUser")
  contactAttachments ContactAttachment[] @relation("ContactAttachmentUploader")

  proformaScenarios ProformaScenario[] @relation("ProformaCreator")
  proformaShares    ProformaShare[]    @relation("ProformaShareCreator")

  emailPreferences UserEmailPreferences? @relation("UserEmailPrefs")
  emailLogs        EmailLog[]            @relation("UserEmailLog")

  @@index([username])
  @@index([email])
  @@index([role])
  @@map("users")
}

model ProformaScenario {
  id          String   @id @default(cuid())
  name        String
  description String?
  assumptions Json
  isDefault   Boolean  @default(false) @map("is_default")
  locked      Boolean  @default(false)
  isVariant   Boolean  @default(false) @map("is_variant")
  parentId    String?  @map("parent_id")
  createdById String   @map("created_by_id")
  createdBy   User     @relation("ProformaCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   ProformaScenario?  @relation("ScenarioVariants", fields: [parentId], references: [id], onDelete: SetNull)
  variants ProformaScenario[] @relation("ScenarioVariants")
  shares   ProformaShare[]    @relation("ShareVariant")

  @@index([createdById])
  @@index([isVariant])
  @@index([parentId])
  @@map("proforma_scenarios")
}

// A share token grants access to exactly ONE variant clone in one mode.
// The token can never reach a master scenario (enforced in the token routes).
model ProformaShare {
  id          String   @id @default(cuid())
  token       String   @unique
  scenarioId  String   @map("scenario_id") // always points at a variant clone
  scenario    ProformaScenario @relation("ShareVariant", fields: [scenarioId], references: [id], onDelete: Cascade)
  mode        String   @default("view") // "view" | "edit"
  revoked     Boolean  @default(false)
  createdById String   @map("created_by_id")
  createdBy   User     @relation("ProformaShareCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([token])
  @@index([scenarioId])
  @@map("proforma_shares")
}

model CharacterizationReference {
  id          String    @id @default(cuid())
  source      String // "Dr. Li", "ISO", "ASTM", "GEIC Raw", "GEIC Milled", etc.
  sourceType  String    @map("source_type") // "academic", "standard", "external_lab", "production"
  testType    String    @map("test_type") // "BET", "Conductivity", "RAMAN", "XPS", "ICP-OES", "TGA", etc.
  value       Decimal?  @db.Decimal(20, 6)
  valueString String?   @map("value_string") // For non-numeric values or complex notations
  unit        String?
  conditions  Json? // { pressure: "20kN", temperature: "25C", etc. }
  testDate    DateTime? @map("test_date")
  notes       String?
  isRange     Boolean   @default(false) @map("is_range") // For standards that specify ranges
  minValue    Decimal?  @map("min_value") @db.Decimal(20, 6) // For range values
  maxValue    Decimal?  @map("max_value") @db.Decimal(20, 6) // For range values
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([source, testType])
  @@index([source])
  @@index([testType])
  @@index([sourceType])
  @@map("characterization_references")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?    @map("due_date")
  startDate   DateTime?  @map("start_date")
  position    Int          @default(0)
  tags        String[]     @default([])

  cost       Decimal?  @db.Decimal(12, 2)
  costPaid   Boolean   @default(false) @map("cost_paid")
  costPaidAt DateTime? @map("cost_paid_at")

  creatorId String @map("creator_id")
  creator   User   @relation("TaskCreator", fields: [creatorId], references: [id])

  parentId String? @map("parent_id")
  parent   Task?   @relation("TaskSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks Task[]  @relation("TaskSubtasks")

  goalId String? @map("goal_id")
  goal   Goal?   @relation("GoalTasks", fields: [goalId], references: [id], onDelete: SetNull)

  assignees TaskAssignment[]

  comments    TaskComment[]
  activities  TaskActivity[]
  attachments TaskAttachment[]

  blockedBy TaskDependency[] @relation("TaskBlockedBy")
  blocking  TaskDependency[] @relation("TaskBlocking")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([priority])
  @@index([creatorId])
  @@index([parentId])
  @@index([goalId])
  @@index([dueDate])
  @@index([status, position])
  @@index([costPaid, cost])
  @@map("tasks")
}

enum GoalStatus {
  ACTIVE
  ON_HOLD
  ACHIEVED
  ABANDONED
}

enum TagKind {
  CATEGORY
  INSTITUTION
}

model Tag {
